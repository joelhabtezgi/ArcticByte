<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="se.lu.ics.Controllers.EmployeeAddController"
           prefWidth="1000.0" prefHeight="650.0" minWidth="1000.0" minHeight="650.0"
           style="-fx-background-color: linear-gradient(to bottom, #f0f4f7, #d9e4ec);">
    
    <VBox spacing="20" 
          AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20"
          AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20">
        
        <!-- Title -->
        <Label text="Add / Delete Consultant" 
               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-underline: true;"/>
        
        <!-- Main Content Area -->
        <HBox spacing="20" VBox.vgrow="ALWAYS" prefWidth="960" minWidth="960">
            
            <!-- Left Panel - Add Consultant -->
            <VBox spacing="15" prefWidth="350" minWidth="350" maxWidth="350" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;">
                <Label text="Add New Consultant" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-smoothing-type: lcd;"/>
                
                <VBox spacing="12">
                    <VBox spacing="8">
                        <Label text="First Name:" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 14;"/>
                        <TextField fx:id="txtFirstName" promptText="Enter first name" prefWidth="280" maxWidth="280" minWidth="280"
                                 style="-fx-background-radius: 8; -fx-padding: 8; -fx-border-color: #ced4da; -fx-border-radius: 8; -fx-border-width: 1; -fx-font-size: 13; -fx-pref-height: 35; -fx-min-width: 280; -fx-max-width: 280;"/>
                    </VBox>
                    
                    <VBox spacing="8">
                        <Label text="Last Name:" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 14;"/>
                        <TextField fx:id="txtLastName" promptText="Enter last name" prefWidth="280" maxWidth="280" minWidth="280"
                                 style="-fx-background-radius: 8; -fx-padding: 8; -fx-border-color: #ced4da; -fx-border-radius: 8; -fx-border-width: 1; -fx-font-size: 13; -fx-pref-height: 35; -fx-min-width: 280; -fx-max-width: 280;"/>
                    </VBox>
                    
                    <VBox spacing="8">
                        <Label text="Salary:" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 14;"/>
                        <TextField fx:id="txtSalary" promptText="Enter salary" prefWidth="280" maxWidth="280" minWidth="280"
                                 style="-fx-background-radius: 8; -fx-padding: 8; -fx-border-color: #ced4da; -fx-border-radius: 8; -fx-border-width: 1; -fx-font-size: 13; -fx-pref-height: 35; -fx-min-width: 280; -fx-max-width: 280;"/>
                    </VBox>
                    
                    <VBox spacing="8">
                        <Label text="Title:" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 14;"/>
                        <TextField fx:id="txtTitle" promptText="Enter title" prefWidth="280" maxWidth="280" minWidth="280"
                                 style="-fx-background-radius: 8; -fx-padding: 8; -fx-border-color: #ced4da; -fx-border-radius: 8; -fx-border-width: 1; -fx-font-size: 13; -fx-pref-height: 35; -fx-min-width: 280; -fx-max-width: 280;"/>
                    </VBox>
                    
                    <VBox spacing="8">
                        <Label text="Select Projects:" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 14;"/>
                        <ListView fx:id="lstProjects" prefHeight="100"
                                  style="-fx-background-radius: 8; -fx-border-color: #ced4da; -fx-border-radius: 8; -fx-border-width: 1;"/>
                        <Label text="Hold Ctrl to select multiple projects"
                               style="-fx-text-fill: #7f8c8d; -fx-font-size: 12;"/>
                    </VBox>
                </VBox>

                <!-- Add Button -->
                <VBox spacing="10" style="-fx-padding: 10 0 0 0;">
                    <Button fx:id="btnAdd" text="Add Consultant" onAction="#handleAddConsultant" prefWidth="280" minWidth="280" maxWidth="280"
                            style="-fx-background-color: #27ae60; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: 600; -fx-font-size: 14; -fx-pref-height: 38; -fx-min-width: 280; -fx-max-width: 280;"/>
                    <Label fx:id="lblAddStatus" text="" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 12;"/>
                </VBox>
            </VBox>

            <!-- Right Panel - Delete Consultant -->
            <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;">
                <Label text="Delete Consultant" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-smoothing-type: lcd;"/>
                
                <TableView fx:id="tblEmployees" VBox.vgrow="ALWAYS" 
                          style="-fx-background-color: #f8f9fa; -fx-border-color: #bdc3c7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 14;">
                    <columns>
                        <TableColumn fx:id="colEmployeeNo" text="Employee No" prefWidth="140" 
                                    style="-fx-font-weight: bold;"/>
                        <TableColumn fx:id="colFirstName" text="First Name" prefWidth="140" 
                                    style="-fx-font-weight: bold;"/>
                        <TableColumn fx:id="colLastName" text="Last Name" prefWidth="140" 
                                    style="-fx-font-weight: bold;"/>
                        <TableColumn fx:id="colTitle" text="Title" prefWidth="250" 
                                    style="-fx-font-weight: bold;"/>
                        <TableColumn fx:id="colSalary" text="Salary" prefWidth="140" 
                                    style="-fx-font-weight: bold;"/>
                        <TableColumn fx:id="colProject" text="Projects" prefWidth="1000" 
                                    style="-fx-font-weight: bold;"/>
                    </columns>
                </TableView>
                
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="btnDelete" text="Delete Selected" onAction="#handleDeleteConsultant"
                            style="-fx-background-color: #e74c3c; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: 600;"/>
                    <Label fx:id="lblDeleteStatus" text="" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 12;"/>
                </HBox>
            </VBox>
        </HBox>
        
        <!-- Bottom Navigation -->
        <HBox alignment="CENTER">
            <Button fx:id="btnBack" text="← Back to Overview" onAction="#handleBack"
                    style="-fx-background-color: #95a5a6; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: 600; -fx-font-size: 14; -fx-pref-height: 38;"/>
        </HBox>
    </VBox>
</AnchorPane>
