<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="650.0" minWidth="1020.0" prefHeight="650.0" prefWidth="1020.0" style="-fx-background-color: linear-gradient(to bottom, #f0f4f7, #d9e4ec);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="se.lu.ics.Controllers.EmployeeViewController">
    
    <VBox spacing="20" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="20">
        
        <!-- Title -->
        <Label fx:id="lblTitle" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-underline: true;" text="Consultant Overview" />
        
        <!-- Main Content Area -->
        <HBox spacing="20" VBox.vgrow="ALWAYS">
            
            <!-- Left Search & Actions Panel -->
            <VBox prefWidth="400" minWidth="400" spacing="12" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;">
                <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-smoothing-type: lcd;" text="Search and Filter Consultants" />
                
                <!-- Search Fields -->
                <VBox spacing="10">
                    <VBox spacing="5">
                        <Label style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 14;" text="Employee No:" />
                        <TextField fx:id="txtEmployeeId" promptText="Search by Employee No" prefWidth="360" maxWidth="360"
                                  style="-fx-background-radius: 8; -fx-padding: 8; -fx-border-color: #ced4da; -fx-border-radius: 8; -fx-border-width: 1; -fx-font-size: 13; -fx-pref-height: 35;" />
                    </VBox>
                    
                    <VBox spacing="5">
                        <Label style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 14;" text="Title:" />
                        <TextField fx:id="txtTitle" promptText="Search by Title" prefWidth="360" maxWidth="360"
                                  style="-fx-background-radius: 8; -fx-padding: 8; -fx-border-color: #ced4da; -fx-border-radius: 8; -fx-border-width: 1; -fx-font-size: 13; -fx-pref-height: 35;" />
                    </VBox>
                    
                    <VBox spacing="5">
                        <Label style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 14;" text="Project:" />
                        <TextField fx:id="txtProject" promptText="Search by Project" prefWidth="360" maxWidth="360"
                                  style="-fx-background-radius: 8; -fx-padding: 8; -fx-border-color: #ced4da; -fx-border-radius: 8; -fx-border-width: 1; -fx-font-size: 13; -fx-pref-height: 35;" />
                    </VBox>
                </VBox>

                <!-- Action Buttons -->
                <VBox spacing="8" style="-fx-padding: 12 0 0 0;">
                    <Button fx:id="btnLoadAll" onAction="#handleLoadAll" prefWidth="360" style="-fx-background-color: #3498db; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: 600; -fx-font-size: 14; -fx-pref-height: 38;" text="Load All Consultants" />
                    <Button fx:id="btnLoadThreeOrFewer" onAction="#handleLoadThreeOrFewer" prefWidth="360" style="-fx-background-color: #27ae60; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: 600; -fx-font-size: 14; -fx-pref-height: 38;" text="Consultants in ≤3 Projects" />
                </VBox>
                
                <!-- Management Buttons -->
                <VBox spacing="8" style="-fx-padding: 12 0 0 0;">
                    <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Consultant Management" />
                    <Button fx:id="btnAddDelete" onAction="#handleGoToAddDelete" prefWidth="360" style="-fx-background-color: #e67e22; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: 600; -fx-font-size: 14; -fx-pref-height: 38;" text="Add/Delete Consultant" />
                    <Button fx:id="btnEdit" onAction="#handleGoToEdit" prefWidth="360" style="-fx-background-color: #f39c12; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: 600; -fx-font-size: 14; -fx-pref-height: 38;" text="Edit Consultant" />
                </VBox>
                
                <!-- Statistics -->
                <VBox spacing="5" style="-fx-padding: 12 0 0 0;">
                    <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Statistics" />
                    <Label fx:id="lblTotalConsultants" style="-fx-text-fill: #34495e; -fx-font-size: 13;" text="Total consultants: 0" visible="false" />
                    <Label fx:id="lblThreeOrFewer" style="-fx-text-fill: #34495e; -fx-font-size: 13;" text="In ≤3 projects: 0" visible="false" />
                </VBox>
            </VBox>

            <!-- Right Table Panel -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-smoothing-type: lcd;" text="All Consultants" />
                
                <TableView fx:id="tblEmployees" style="-fx-background-color: #f8f9fa; -fx-border-color: #bdc3c7; -fx-border-radius: 8; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colEmployeeNo" prefWidth="100" text="Employee No" />
                        <TableColumn fx:id="colFirstName" prefWidth="200" text="First Name" />
                        <TableColumn fx:id="colLastName" prefWidth="200" text="Last Name" />
                        <TableColumn fx:id="colSalary" prefWidth="150" text="Salary" />
                        <TableColumn fx:id="colTitle" prefWidth="200" text="Title" />
                        <TableColumn fx:id="colProject" prefWidth="1200" text="Projects" />
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </VBox>
</AnchorPane>
