<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="1020.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="se.lu.ics.Controllers.ExcelViewController">
   <children>
      <Label alignment="CENTER" layoutX="20.0" layoutY="13.0" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Excel export">
         <font>
            <Font name="System Bold" />
         </font>
      </Label>
      <Button fx:id="btnDownloadDesktop" layoutX="20.0" layoutY="80.0" mnemonicParsing="false" onAction="#onOpenExcelOnlineClick" prefHeight="39.0" prefWidth="180.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="Download for Desktop" />
      <Label layoutX="20.0" layoutY="55.0" text="Download and open in Excel Desktop (supports database connections):" />
      <Button fx:id="btnOpenExcelWeb" layoutX="220.0" layoutY="80.0" mnemonicParsing="false" onAction="#onOpenExcelWebClick" prefHeight="39.0" prefWidth="150.0" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Excel Online" />
      <Label layoutX="380.0" layoutY="85.0" style="-fx-font-size: 11; -fx-text-fill: #e74c3c; -fx-font-weight: bold;" text="⚠ Database connections only work in Desktop Excel" />
      <Label layoutX="20.0" layoutY="125.0" text="Or view online (limited functionality - no database refresh):" />
