<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<AnchorPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="se.lu.ics.Controllers.WorkViewController"
           prefWidth="1020.0" prefHeight="650.0"
           style="-fx-background-color: linear-gradient(to bottom, #f0f4f7, #d9e4ec);">


   <children>
       <VBox spacing="20"
             AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20"
             AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20">


           <!-- Title -->
           <Label text="Work Overview"
                  style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-underline: true;"/>


           <!-- Toolbar -->
           <HBox spacing="10">
               <Button fx:id="btnWorkLoadAll" text="Load All" onAction="#handleWorkLoadAll"
                       style="-fx-background-color: #3498db; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-weight: 600;"/>
               <TextField fx:id="filterField"
                          promptText="Filter: proj:123, emp:45, hours:40, name:John, allconsultants…"
                          HBox.hgrow="ALWAYS"
                          style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #cfd9e3; -fx-padding: 6 10;"/>
               <Button fx:id="btnShowHardest" text="Show hardest worker" onAction="#handleShowHardest"
                       style="-fx-background-color: #16a085; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-weight: 600;"/>
               <Button fx:id="btnShowAllConsultantProjects" text="Projects with All Consultants" onAction="#handleShowAllConsultantProjects"
                       style="-fx-background-color: #8e44ad; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-weight: 600;"/>
           </HBox>


           <!-- Main split -->
           <HBox spacing="15" VBox.vgrow="ALWAYS">


               <!-- LEFT: Form card -->
               <VBox spacing="8" prefWidth="320" minWidth="320"
                     style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 4);">


                   <Label text="ProjectNo" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                   <ComboBox fx:id="cbWorkProjectNo" promptText="Select project…" prefWidth="200" maxWidth="200" 
                            style="-fx-pref-height: 32; -fx-font-size: 12;"/>


                   <Label text="EmployeeNo" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                   <ComboBox fx:id="cbWorkEmployeeNo" promptText="Select employee…" prefWidth="200" maxWidth="200"
                            style="-fx-pref-height: 32; -fx-font-size: 12;"/>


                   <Label text="Hours" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                   <TextField fx:id="txtWorkHours" promptText="e.g. 8" prefWidth="200" maxWidth="200"
                             style="-fx-pref-height: 32; -fx-font-size: 12;"/>
                   <Label fx:id="hoursError" textFill="#c0392b" style="-fx-font-size: 11;" visible="false" managed="false"/>


                   <!-- Buttons -->
                   <VBox spacing="6" style="-fx-padding: 8 0 0 0;">
                       <Button fx:id="btnAddWork" text="Add" onAction="#handleAddWork" maxWidth="Infinity"
                               style="-fx-background-color: #3498db; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 12;"/>
                       <Button fx:id="btnUpdateWork" text="Update" onAction="#handleUpdateWork" maxWidth="Infinity"
                               style="-fx-background-color: #2980b9; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 12;"/>
                       <Button fx:id="btnDeleteWork" text="Delete" onAction="#handleDeleteWork" maxWidth="Infinity"
                               style="-fx-background-color: #e74c3c; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 12;"/>
                       <Button fx:id="btnWorkClearFields" text="Clear" onAction="#handleWorkClearFields" maxWidth="Infinity"
                               style="-fx-background-color: #95a5a6; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 12;"/>
                   </VBox>


                   <Separator style="-fx-padding: 4 0;"/>


                   <!-- Totals -->
                   <VBox spacing="4">
                       <Label text="Employee total hours:" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                       <Label fx:id="lblEmployeeTotal" text="—" style="-fx-font-size: 11;"/>
                       <Label text="All company hours:" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                       <Label fx:id="lblAllTotal" text="—" style="-fx-font-size: 11;"/>
                       <Label text="Company FTE weeks:" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                       <Label fx:id="lblCompanyFteWeeks" text="—" style="-fx-font-size: 11;"/>
                       <Label text="FTE = Full Time Equivalent (hours ÷ 40)" 
                              style="-fx-font-size: 9; -fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
                       <Label text="Hardest worker:" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                       <Label fx:id="lblHardest" text="—" style="-fx-font-size: 11;"/>
                       <Label text="Project share:" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                       <Label fx:id="lblProjectShare" text="—" style="-fx-font-size: 11;"/>
                   </VBox>
               </VBox>


               <!-- RIGHT: Table -->
               <VBox spacing="6" VBox.vgrow="ALWAYS"
                     style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 4);"
                     HBox.hgrow="ALWAYS">


                   <TableView fx:id="tbWork" VBox.vgrow="ALWAYS"
                              style="-fx-font-size: 12;">
                       <columns>
                           <TableColumn fx:id="coWorkProjectNo" text="ProjectNo" prefWidth="85" minWidth="70"/>
                           <TableColumn fx:id="coWorkEmployeeNo" text="EmployeeNo" prefWidth="90" minWidth="80"/>
                           <TableColumn fx:id="coWorkEmployeeName" text="Employee Name" prefWidth="200" minWidth="150"/>
                           <TableColumn fx:id="coWorkHours" text="Hours" prefWidth="70" minWidth="60"/>
                           <TableColumn fx:id="coWorkWeeksFte" text="Work weeks (FTE)" prefWidth="130" minWidth="120"/>
                       </columns>
                   </TableView>
               </VBox>
           </HBox>
       </VBox>
   </children>
</AnchorPane>


