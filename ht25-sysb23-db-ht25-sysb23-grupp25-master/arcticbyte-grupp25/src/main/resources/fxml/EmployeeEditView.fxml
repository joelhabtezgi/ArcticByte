<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="1020.0" minWidth="1020.0" minHeight="650.0" 
      style="-fx-background-color: linear-gradient(to bottom, #f0f4f7, #d9e4ec);" 
      spacing="20" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="se.lu.ics.Controllers.EmployeeEditController">

  <!-- Title -->
  <Label alignment="CENTER" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-underline: true;" 
         text="Edit Consultant">
    <font>
      <Font size="28.0" />
    </font>
  </Label>

  <!-- Main Content Area -->
  <HBox spacing="20" style="-fx-padding: 0 20 20 20;" VBox.vgrow="ALWAYS">
    
    <!-- Left Panel - Edit Form -->
    <VBox spacing="15" prefWidth="400" 
          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
      
      <Label text="Edit Consultant Information" 
             style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 18;"/>
      
      <!-- Employee Details Form -->
      <VBox spacing="10">
        <Label text="First Name:" style="-fx-text-fill: #34495e; -fx-font-weight: 600;"/>
        <TextField fx:id="txtFirstName" prefWidth="340" 
                   style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"/>
        
        <Label text="Last Name:" style="-fx-text-fill: #34495e; -fx-font-weight: 600;"/>
        <TextField fx:id="txtLastName" prefWidth="340" 
                   style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"/>
        
        <Label text="Title:" style="-fx-text-fill: #34495e; -fx-font-weight: 600;"/>
        <TextField fx:id="txtTitle" prefWidth="340" 
                   style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"/>
        
        <Label text="Salary:" style="-fx-text-fill: #34495e; -fx-font-weight: 600;"/>
        <TextField fx:id="txtSalary" prefWidth="340" 
                   style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"/>
      </VBox>
      
      <!-- Action Buttons -->
      <VBox spacing="10" style="-fx-padding: 20 0 0 0;">
        <Button fx:id="btnUpdate" text="Update Consultant" prefWidth="340"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 14; -fx-padding: 10;"/>
        <Button fx:id="btnBack" text="Back to Overview" prefWidth="340"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 14; -fx-padding: 10;"/>
      </VBox>
      
      <!-- Status Label -->
      <Label fx:id="lblUpdateStatus" text="" 
             style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 14;"/>
    </VBox>
    
    <!-- Right Panel - Project Assignment -->
    <VBox spacing="15" HBox.hgrow="ALWAYS" 
          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
      
      <Label text="Project Assignment" 
             style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 18;"/>
      
      <Label text="Select projects for this consultant:" 
             style="-fx-text-fill: #34495e; -fx-font-weight: 600;"/>
      
      <!-- Scrollable Project List -->
      <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" 
                  style="-fx-background: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5;">
        <VBox fx:id="vboxProjects" spacing="8" style="-fx-padding: 15;">
          <!-- CheckBoxes will be added dynamically in controller -->
        </VBox>
      </ScrollPane>
    </VBox>
    
  </HBox>
</VBox>
