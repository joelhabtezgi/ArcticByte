<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="se.lu.ics.Controllers.MetadataViewController"
           prefWidth="1020.0" prefHeight="650.0"
           style="-fx-background-color: linear-gradient(to bottom, #f0f4f7, #d9e4ec);">

   <children>
       <VBox spacing="20"
             AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20"
             AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20">

           <!-- Title -->
           <Label text="Database Metadata Overview"
                  style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-underline: true;"/>

           <!-- Main Content Area -->
           <HBox spacing="20" VBox.vgrow="ALWAYS">
               
               <!-- Left Control Panel -->
               <VBox spacing="15" prefWidth="300" 
                     style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 4);">
                   
                   <Label text="Metadata Actions" 
                          style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                   
                   <!-- Query Buttons -->
                   <VBox spacing="10">
                       <Button fx:id="btnShowAllColumns" text="Show all columns" onAction="#onShowAllColumns"
                               style="-fx-background-color: #3498db; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: 600; -fx-pref-width: 260;"/>
                       
                       <Button fx:id="btnShowPrimaryKeys" text="Show Primary Keys" onAction="#onShowPrimaryKeys"
                               style="-fx-background-color: #16a085; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: 600; -fx-pref-width: 260;"/>
                       
                       <Button fx:id="btnShowCheckConstraints" text="Show Check Constraints" onAction="#onShowCheckConstraints"
                               style="-fx-background-color: #f39c12; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: 600; -fx-pref-width: 260;"/>
                       
                       <Button fx:id="btnShowConsultantNonInt" text="Show Non-INT Columns (Consultant)" onAction="#onShowConsultantNonInt"
                               style="-fx-background-color: #9b59b6; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: 600; -fx-pref-width: 260;"/>
                       
                       <Button fx:id="btnShowLargestTable" text="Show Largest Table by Rows" onAction="#onShowLargestTable"
                               style="-fx-background-color: #e67e22; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: 600; -fx-pref-width: 260;"/>
                   </VBox>

                   <Separator/>

                   <!-- Utility Actions -->
                   <VBox spacing="10">
                       <Label text="Utilities" 
                              style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                       
                       <Button fx:id="btnRefreshAll" text="Refresh List" onAction="#onRefreshAll"
                               style="-fx-background-color: #95a5a6; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: 600; -fx-pref-width: 260;"/>
                   </VBox>
               </VBox>

               <!-- Right Results Panel -->
               <VBox spacing="15" HBox.hgrow="ALWAYS" 
                     style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 4);">
                   
                   <HBox spacing="10" alignment="CENTER_LEFT">
                       <Label fx:id="resultsTitle" text="Metadata Results" 
                              style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                       <Region HBox.hgrow="ALWAYS"/>
                       <Label fx:id="resultCount" text="" 
                              style="-fx-font-size: 12; -fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
                   </HBox>
                   
                   <!-- Table for structured data -->
                   <TableView fx:id="metadataTable" VBox.vgrow="ALWAYS"
                             style="-fx-background-radius: 8; -fx-border-radius: 8;">
                       <columns>
                           <TableColumn fx:id="colSchema" text="Schema" prefWidth="100" />
                           <TableColumn fx:id="colTable" text="Table" prefWidth="150" />
                           <TableColumn fx:id="colName" text="Name" prefWidth="200" />
                           <TableColumn fx:id="colType" text="Type/Details" prefWidth="200" />
                           <TableColumn fx:id="colExtra" text="Extra Info" prefWidth="250" />
                       </columns>
                   </TableView>
               </VBox>
           </HBox>
       </VBox>
   </children>
</AnchorPane>
