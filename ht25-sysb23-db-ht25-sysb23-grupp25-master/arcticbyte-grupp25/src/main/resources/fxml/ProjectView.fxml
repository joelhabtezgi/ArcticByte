<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="se.lu.ics.Controllers.ProjectViewController"
           prefWidth="1020.0" prefHeight="650.0"
           style="-fx-background-color: linear-gradient(to bottom, #f0f4f7, #d9e4ec);">
    
    <VBox spacing="20" 
          AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20"
          AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20">
        
        <!-- Title -->
        <Label text="Project Overview" 
               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-underline: true;"/>
        
        <!-- Main Content Area -->
        <HBox spacing="20" VBox.vgrow="ALWAYS">
            
            <!-- Left Form Panel -->
            <VBox spacing="15" prefWidth="300" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;">
                <Label text="Project Details" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-smoothing-type: lcd;"/>
                
                <VBox spacing="8">
                    <Label text="Project No:" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
                    <HBox spacing="8">
                        <TextField fx:id="txtProjectNo" promptText="" 
                                 style="-fx-background-radius: 8; -fx-padding: 8; -fx-border-color: #ced4da; -fx-border-radius: 8; -fx-border-width: 1;" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnGenerateNew" text="Generate New" onAction="#handleGenerateNew"
                                style="-fx-background-color: #17a2b8; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: 600; -fx-font-size: 10px;"/>
                    </HBox>
                </VBox>
                
                <VBox spacing="8">
                    <Label text="Project Name:" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
                    <TextField fx:id="txtProjectName" promptText="Enter project name"
                             style="-fx-background-radius: 8; -fx-padding: 8;"/>
                </VBox>
                
                <VBox spacing="8">
                    <Label text="Start Date:" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
                    <DatePicker fx:id="dpStartDate" promptText="Select start date"
                              style="-fx-background-radius: 8;"/>
                </VBox>
                
                <VBox spacing="8">
                    <Label text="End Date:" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
                    <DatePicker fx:id="dpEndDate" promptText="Select end date (optional)"
                              style="-fx-background-radius: 8;"/>
                </VBox>

                <!-- Action Buttons -->
                <VBox spacing="10" style="-fx-padding: 10 0 0 0;">
                    <HBox spacing="10">
                        <Button fx:id="btnAddProject" text="Add" onAction="#handleAddProject" prefWidth="85"
                                style="-fx-background-color: #27ae60; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: 600;"/>
                        <Button fx:id="btnUpdateProject" text="Update" onAction="#handleUpdateProject" prefWidth="85"
                                style="-fx-background-color: #f39c12; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: 600;"/>
                        <Button fx:id="btnDeleteProject" text="Delete" onAction="#handleDeleteProject" prefWidth="85"
                                style="-fx-background-color: #e74c3c; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: 600;"/>
                    </HBox>
                    <Button text="Clear Fields" onAction="#clearForm"
                            style="-fx-background-color: #95a5a6; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: 600;"/>
                </VBox>
            </VBox>

            <!-- Right Table Panel -->
            <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;">
                <Label text="All Projects" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-smoothing-type: lcd;"/>
                
                <TableView fx:id="tableProject" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="columnProjectNo" text="Project No" prefWidth="120"/>
                        <TableColumn fx:id="columnProjectName" text="Project Name" prefWidth="200"/>
                        <TableColumn fx:id="columnStartDate" text="Start Date" prefWidth="120"/>
                        <TableColumn fx:id="columnEndDate" text="End Date" prefWidth="120"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <style>
                        -fx-background-color: white;
                        -fx-background-radius: 8;
                        -fx-border-color: #e0e0e0;
                        -fx-border-radius: 8;
                        -fx-border-width: 1;
                    </style>
                </TableView>

                <!-- Control Buttons -->
                <HBox spacing="10" style="-fx-padding: 10 0 0 0;">
                    <Button fx:id="btnSearchProject" text="Search" onAction="#handleSearchProject"
                            style="-fx-background-color: #2ecc71; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: 600;"/>
                    <Button text="Show All" onAction="#displayAllProjects"
                            style="-fx-background-color: #3498db; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: 600;"/>
                </HBox>
            </VBox>
        </HBox>
    </VBox>
</AnchorPane>
